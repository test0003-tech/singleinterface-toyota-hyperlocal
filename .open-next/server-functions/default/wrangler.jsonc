{
  "$schema": "node_modules/wrangler/config-schema.json",
  "main": ".open-next/worker.js",
  "name": "singleinterface-toyota-hyperlocal",
  "compatibility_date": "2025-05-01",
  "compatibility_flags": ["nodejs_compat", "global_fetch_strictly_public"],
  "assets": {
    "directory": ".open-next/assets",
    "binding": "ASSETS"
  },
  "services": [
    {
      // Self-reference service binding — the service name MUST match the
      // worker name above. Used by OpenNext for internal Next.js fetches.
      "binding": "WORKER_SELF_REFERENCE",
      "service": "singleinterface-toyota-hyperlocal"
    }
  ],
  "d1_databases": [
    {
      // The Prisma D1 adapter reads this binding (env.DB) in src/lib/db.ts.
      "binding": "DB",
      "database_name": "singleinterface-toyota",
      "database_id": "620385b1-d5d7-47c3-8182-700aa0ca037e"
    }
  ]
}
