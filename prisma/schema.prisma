// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SI Data - 23 fields from "SI data" sheet
model SIRecord {
  id                 String   @id @default(cuid())
  siCode             String   @unique
  clientCode         String
  businessProfileId  String?
  businessName       String?
  alternativeName    String?
  circle             String?
  address1           String?
  address2           String?
  locality           String?
  landmark           String?
  city               String?
  state              String?
  postcode           String?
  latitude           String?
  longitude          String?
  googlePlusPage     String?
  vmnSi              String?
  weeklyOff          String?
  businessHours      String?
  website            String?
  placeId            String?
  locationGroup      String?
  gmbListingStatus   String?
  // Live status & VMN mapping
  isLive               Boolean  @default(false)
  liveSince            DateTime?
  salesLandingNumbers  String?  // comma-separated 10-digit mobile numbers, up to 5
  serviceLandingNumbers String? // comma-separated 10-digit mobile numbers, up to 5
  linkedSpotlightCode  String?  // links to SpotlightRecord.clientCode for live sync
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([clientCode])
  @@index([state])
  @@index([circle])
  @@index([city])
  @@index([isLive])
}

// Spotlight Data - 17 fields from "Spotlight data" sheet
model SpotlightRecord {
  id                 String   @id @default(cuid())
  clientCode         String   @unique
  name               String?
  alternateName      String?
  internalCode       String?
  region             String?
  state              String?
  city               String?
  country            String?
  pincode            String?
  locality           String?
  addressLine1       String?
  latitude           String?
  longitude          String?
  vmn                String?
  domain             String?
  adAccountCid       String?
  facebookPageId     String?
  // Live status & VMN mapping
  isLive                 Boolean  @default(false)
  liveSince              DateTime?
  spotlightLandingNumbers String? // comma-separated 10-digit mobile numbers, up to 5
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([state])
  @@index([region])
  @@index([city])
  @@index([isLive])
}

// Media Spend - per Spotlight location per month, bifurcated by platform (Meta + Google)
model MediaSpend {
  id                  String   @id @default(cuid())
  recordType          String   // "Spotlight" (media spend is only for Spotlight)
  recordCode          String   // clientCode (Spotlight)
  month               String   // "YYYY-MM"
  // Meta (Facebook/Instagram ads)
  metaAllocated       Float    @default(0) // Meta budget added to wallet that month
  metaUtilized        Float    @default(0) // Meta amount spent that month
  metaPendingInWallet Float    @default(0) // Meta balance carried to next month
  // Google (Google Ads)
  googleAllocated       Float    @default(0) // Google budget added to wallet that month
  googleUtilized        Float    @default(0) // Google amount spent that month
  googlePendingInWallet Float    @default(0) // Google balance carried to next month
  // Computed totals (auto-calculated: meta + google)
  allocated       Float    @default(0) // total budget = metaAllocated + googleAllocated
  utilized        Float    @default(0) // total spent = metaUtilized + googleUtilized
  pendingInWallet Float    @default(0) // total pending = metaPending + googlePending
  // Media payment / billing — invoiced to client, received, TDS auto-calculated
  gstRate         Float    @default(18) // GST rate applied to utilized amount
  gstAmount       Float    @default(0) // auto: utilized * gstRate / 100
  invoicedAmount  Float    @default(0) // auto: utilized + gstAmount (amount billed to client)
  receivedAmount  Float    @default(0) // amount actually received from client
  tdsAmount       Float    @default(0) // auto: invoicedAmount - receivedAmount
  tdsPercentage   Float    @default(0) // auto: (tdsAmount / invoicedAmount) * 100
  notes           String?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@unique([recordType, recordCode, month])
  @@index([recordType, recordCode])
  @@index([month])
}

// Platform Fees - per location per month (fixed 8060 + 18% GST)
model PlatformFee {
  id            String    @id @default(cuid())
  recordType    String    // "SI" or "Spotlight"
  recordCode    String    // siCode (SI) or clientCode (Spotlight)
  month         String    // "YYYY-MM"
  invoiceNumber String?   // optional invoice reference
  baseAmount    Float     @default(8060)
  gstRate       Float     @default(18)
  gstAmount     Float     @default(1450.8)
  totalAmount   Float     @default(9510.8)
  lateFee       Float     @default(0) // additional late fee if applicable
  // Payment tracking
  amountPaid    Float     @default(0) // sum of all payments
  paymentStatus String    @default("unpaid") // "unpaid" | "partial" | "paid"
  dueDate       DateTime? // when payment is due
  paidAt        DateTime? // fully paid date
  notes         String?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  payments      Payment[]

  @@unique([recordType, recordCode, month])
  @@index([recordType, recordCode])
  @@index([month])
  @@index([paymentStatus])
  @@index([dueDate])
}

// Individual payment transactions - one fee can have multiple payments
model Payment {
  id            String   @id @default(cuid())
  platformFeeId String   // FK to PlatformFee
  amount        Float    // payment amount
  method        String   @default("bank_transfer") // "bank_transfer" | "cheque" | "upi" | "cash" | "card" | "other"
  reference     String?  // transaction ID, cheque number, UPI ref, etc.
  paidDate      DateTime @default(now()) // when the payment was made
  notes         String?
  createdAt     DateTime @default(now())
  platformFee   PlatformFee @relation(fields: [platformFeeId], references: [id], onDelete: Cascade)

  @@index([platformFeeId])
  @@index([paidDate])
  @@index([method])
}

// Custom Alert Rules - user-defined rules that generate alerts
// when evaluated against the current data.
model Rule {
  id          String   @id @default(cuid())
  name        String
  description String?
  // What type of record this rule evaluates
  targetType  String   // "SI" | "Spotlight" | "MediaSpend" | "PlatformFee"
  // The field on that record to check
  field       String   // e.g. "allocated", "utilized", "isPaid", "isLive", "gmbListingStatus", "utilizationPercent"
  // Comparison operator
  operator    String   // "equals" | "not_equals" | "greater_than" | "less_than" | "contains" | "is_empty" | "is_not_empty" | "days_overdue"
  // The value to compare against (string, parsed as number for numeric comparisons)
  value       String?
  // Alert severity when rule matches
  severity    String   @default("warning") // "info" | "warning" | "critical"
  // Scope: evaluate for current month only, or all records
  scopeMonth  Boolean  @default(true) // if true, only current month records
  // Enable/disable
  isEnabled   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([targetType])
  @@index([isEnabled])
}

// Audit Log - tracks all create/update/delete operations on records
model AuditLog {
  id        String   @id @default(cuid())
  action    String   // "create" | "update" | "delete"
  entityType String  // "SI" | "Spotlight" | "MediaSpend" | "PlatformFee" | "Payment" | "Rule"
  entityId  String   // ID of the affected record
  entityCode String? // human-readable code (siCode, clientCode, recordCode+month, etc.)
  changes   String?  // JSON diff of changed fields
  summary   String?  // human-readable summary
  createdAt DateTime @default(now())

  @@index([entityType])
  @@index([entityId])
  @@index([action])
  @@index([createdAt])
}

// Counter for auto-invoice numbering
model Counter {
  id    String @id
  value Int    @default(0)
}


