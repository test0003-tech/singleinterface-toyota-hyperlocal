// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model User {
  id        String   @id @default(cuid())
  email     String   @unique
  name      String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Post {
  id        String   @id @default(cuid())
  title     String
  content   String?
  published Boolean  @default(false)
  authorId  String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// SI Data - 23 fields from "SI data" sheet
model SIRecord {
  id                 String   @id @default(cuid())
  siCode             String   @unique
  clientCode         String
  businessProfileId  String?
  businessName       String?
  alternativeName    String?
  circle             String?
  address1           String?
  address2           String?
  locality           String?
  landmark           String?
  city               String?
  state              String?
  postcode           String?
  latitude           String?
  longitude          String?
  googlePlusPage     String?
  vmnSi              String?
  weeklyOff          String?
  businessHours      String?
  website            String?
  placeId            String?
  locationGroup      String?
  gmbListingStatus   String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([clientCode])
  @@index([state])
  @@index([circle])
  @@index([city])
}

// Spotlight Data - 17 fields from "Spotlight data" sheet
model SpotlightRecord {
  id                 String   @id @default(cuid())
  clientCode         String   @unique
  name               String?
  alternateName      String?
  internalCode       String?
  region             String?
  state              String?
  city               String?
  country            String?
  pincode            String?
  locality           String?
  addressLine1       String?
  latitude           String?
  longitude          String?
  vmn                String?
  domain             String?
  adAccountCid       String?
  facebookPageId     String?
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  @@index([state])
  @@index([region])
  @@index([city])
}
